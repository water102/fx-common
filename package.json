    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/ramda": "^0.31.1",
    "esbuild": "^0.27.2",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "rollup": "^4.54.0",
    "ts-jest": "^29.4.6",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
