    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/ramda": "^0.31.1",
    "esbuild": "^0.28.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "rollup": "^4.61.1",
    "ts-jest": "^29.4.11",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
