{
  "name": "@water102/fx-common",
  "version": "4.0.7",
  "engines": {
    "npm": ">=10.9",
    "node": ">=20"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./type-guards": {
      "types": "./dist/type-guards/index.d.ts",
      "import": "./dist/entries/type-guards.mjs",
      "require": "./dist/entries/type-guards.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/entries/format.mjs",
      "require": "./dist/entries/format.js"
    },
    "./validate": {
      "types": "./dist/validate/index.d.ts",
      "import": "./dist/entries/validate.mjs",
      "require": "./dist/entries/validate.js"
    },
    "./date-time": {
      "types": "./dist/date-time/index.d.ts",
      "import": "./dist/entries/date-time.mjs",
      "require": "./dist/entries/date-time.js"
    },
    "./promise": {
      "types": "./dist/promise/index.d.ts",
      "import": "./dist/entries/promise.mjs",
      "require": "./dist/entries/promise.js"
    },
    "./string": {
      "types": "./dist/string/index.d.ts",
      "import": "./dist/entries/string.mjs",
      "require": "./dist/entries/string.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "npx rimraf dist out",
    "build": "npm run clean && rollup -c",
    "build:prod": "npm run clean && cross-env NODE_ENV=production rollup -c",
    "prepublishOnly": "npm run build:prod",
    "test": "jest",
    "prettier-format": "prettier --config .prettierrc \"src/**/*.ts\" --write"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/ramda": "^0.32.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "rollup": "^4.62.2",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "dayjs": "^1.11.21",
    "nanoid": "^6.0.0",
    "ramda": "^0.32.0",
    "uuid": "^14.0.1"
  }
}
